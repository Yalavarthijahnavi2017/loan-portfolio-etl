# Copy this file to .env and fill in values. Never commit .env.
# Backend choice: "sqlite" (zero setup, default) or "postgres" (production target).
DB_BACKEND=sqlite

# SQLite settings
SQLITE_PATH=data/warehouse/loans.db

# Postgres settings (used only when DB_BACKEND=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loans_dw
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change-me

# Set to 1 to re-download the raw CSV from the public source instead of
# using the bundled sample in data/raw/loans.csv
REFRESH_SOURCE=0
